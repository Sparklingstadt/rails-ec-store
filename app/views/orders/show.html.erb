<% content_for :title, "注文詳細" %>
<div class="container page-space order-complete">
  <div class="success-mark"><%= icon(@order.status == "cancelled" ? "close" : "check") %></div>
  <p class="eyebrow">YOUR ORDER</p>
  <h1><%= { "placed" => "日々の楽しみが、またひとつ。", "shipped" => "デモ発送が完了しました。", "cancelled" => "ご注文をキャンセルしました。" }.fetch(@order.status) %></h1>
  <p><%= @order.status == "placed" ? "デモ注文を受け付けました。余白でのお買い物をお楽しみいただき、ありがとうございます。" : @order.status == "cancelled" ? "商品の在庫を戻しました。ご注文の記録は履歴に残ります。" : "学習用のステータス変更です。実際の商品発送は行われません。" %></p>
  <%= render "receipt", order: @order %>
  <% if @order.cancellable? %>
    <%= button_to "この注文をキャンセル", cancel_order_path(@order), class: "button button-outline", form: { data: { confirm_message: "この注文をキャンセルします。よろしいですか？" } } %>
    <p class="fine-print">受付済みの注文はキャンセルできます。キャンセルすると商品の在庫が戻ります。</p>
  <% end %>
  <p class="fine-print">決済・配送・メール送信は行われません。<%= current_user ? "注文内容はログイン後の注文履歴から確認できます。" : "注文内容はこのブラウザから確認できます。" %></p>
  <div class="button-group"><%= link_to "お買い物を続ける", products_path, class: "button button-dark" %><%= link_to "注文履歴を見る", orders_path, class: "button button-outline" %></div>
</div>
