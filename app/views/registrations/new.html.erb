<% content_for :title, "会員登録" %>
<section class="container page-space auth-page">
  <div class="page-heading"><p class="eyebrow">JOIN YOHAKU</p><h1>会員登録</h1><p>お気に入りと、お買い物の記録をあなたのもとに。</p></div>
  <p class="demo-notice">学習用のデモです。架空のメールアドレスと、このサイト専用のパスワードをお使いください。</p>
  <%= render "shared/errors", record: @user %>
  <%= form_with model: @user, url: registration_path do |form| %>
    <div class="form-field"><%= form.label :name, "お名前" %><%= form.text_field :name, required: true, maxlength: 80, autocomplete: "name" %></div>
    <div class="form-field"><%= form.label :email, "メールアドレス" %><%= form.email_field :email, required: true, maxlength: 254, autocomplete: "email" %></div>
    <div class="form-field"><%= form.label :password, "パスワード" %><%= form.password_field :password, required: true, minlength: 12, maxlength: 72, autocomplete: "new-password" %><small>12文字以上72バイト以内。他のサービスと使い回さないでください。</small></div>
    <div class="form-field"><%= form.label :password_confirmation, "パスワード（確認）" %><%= form.password_field :password_confirmation, required: true, minlength: 12, maxlength: 72, autocomplete: "new-password" %></div>
    <%= form.submit "会員登録する", class: "button button-dark full-width" %>
  <% end %>
  <p class="section-note"><%= link_to "登録済みの方はログイン", new_session_path, class: "text-link" %></p>
</section>
