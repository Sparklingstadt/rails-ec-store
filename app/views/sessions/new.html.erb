<% content_for :title, "ログイン" %>
<section class="container page-space auth-page">
  <div class="page-heading"><p class="eyebrow">WELCOME BACK</p><h1>ログイン</h1><p>おかえりなさい。暮らしの道具を、ひとつずつ。</p></div>
  <%= form_with url: session_path do |form| %>
    <div class="form-field"><%= form.label :email, "メールアドレス" %><%= form.email_field :email, value: params[:email], required: true, autocomplete: "email" %></div>
    <div class="form-field"><%= form.label :password, "パスワード" %><%= form.password_field :password, required: true, autocomplete: "current-password" %></div>
    <%= form.submit "ログインする", class: "button button-dark full-width" %>
  <% end %>
  <p class="section-note"><%= link_to "はじめての方は会員登録", new_registration_path, class: "text-link" %></p>
  <p class="fine-print">学習用のため、メール認証・パスワード再設定メールの機能はありません。</p>
</section>
